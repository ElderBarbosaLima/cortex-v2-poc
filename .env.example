# Copy to .env (`make init-env` does it). Never commit .env.
# Local-dev values only: the stack is ephemeral and binds to 127.0.0.1.
# AWS emulator credentials are never copied here: clients read them from the
# emulator's shared volume.

LOG_LEVEL=INFO
LOG_FORMAT=json
ORG_BRAIN_SERVICE_PORT=5008

# Postgres (local dev only; change them if you like, any value works)
CORTEX_POSTGRES_PORT=5432
POSTGRES_PASSWORD=local-dev-superuser
ORG_BRAIN_OWNER_PASSWORD=local-dev-owner
ORG_BRAIN_APP_PASSWORD=local-dev-app

# OPA (policy decisions; local only)
CORTEX_OPA_PORT=8181

# Static consumer API keys (PoC stand-in for OIDC). Terraform stores only their
# sha256 in Secrets Manager. Local values only.
CORTEX_DEV_API_KEYS='{"askq2c-agent":"local-dev-askq2c-key","decision-desk":"local-dev-decision-desk-key","other-agent":"local-dev-other-key"}'

# The frontend's dev proxy uses this consumer key, server-side only (never in
# the browser bundle). It must be the decision-desk key in CORTEX_DEV_API_KEYS.
CORTEX_DESK_API_KEY=local-dev-decision-desk-key

# make test-e2e-ui sets up its cases as the agent (the askq2c-agent key in
# CORTEX_DEV_API_KEYS).
CORTEX_E2E_AGENT_KEY=local-dev-askq2c-key

# AI (issue 30): every model call goes through LiteLLM. Put your key in .env
# as LITELLM_API_KEY=... (never here); `make provision` stores it in Secrets
# Manager and the service reads it from there. Each use has its own switch.
LITELLM_BASE_URL=https://devs-ai.straker.ai
LLM_RULE_SUGGESTION=false
LLM_EMBEDDINGS=false
