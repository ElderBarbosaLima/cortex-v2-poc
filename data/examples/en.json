        "note_ja": "Paid ¥330 short: the bank transfer fee."
      },
      "proposal": {
        "by": "EN-R-002",
        "enforcement": "default",
        "authority": 10,
        "body": {
          "text_ja": "Refund duplicate payments from CUST-E105 at once.",
          "targets": [
            "allocation.duplicate_payment"
          ],
          "condition": "payment.customer_id == \"CUST-E105\" && payment.candidates_total > 0 && payment.amount >= 2 * payment.candidates_total",
          "exception": "duplicate_payment",
          "engine": {
            "action": "refund"
          }
        },
        "entities": [
          "customer:CUST-E105"
        ]
      },
      "import": {
        "by": "EN-R-001",
        "source_system": "customer-rules-sheet",
        "authority": 20,
        "valid_to": "2027-01-31",
        "entities": [
          "customer:CUST-E102"
        ],
        "body": {
          "text_ja": "Pay several invoices in one transfer: pick them by the PO numbers in the remittance.",
          "targets": [
            "allocation.combined_payment"
          ],
          "condition": "payment.customer_id == \"CUST-E102\" && payment.candidate_count > 1",
          "exception": "combined_payment",
          "engine": {
            "pick": "po_number"
          }
        }
      }
