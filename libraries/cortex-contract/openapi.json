{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": true,
        "properties": {
          "detail": {
            "title": "Detail"
          },
          "error": {
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ContextPack": {
        "properties": {
          "as_of": {
            "format": "date",
            "title": "As Of",
            "type": "string"
          },
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "pack_id": {
            "format": "uuid",
            "title": "Pack Id",
            "type": "string"
          },
          "policy_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Revision"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/PackRecord"
            },
            "title": "Records",
            "type": "array"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "pack_id",
          "trace_id",
          "domain",
          "as_of",
          "policy_revision",
          "records"
        ],
        "title": "ContextPack",
        "type": "object"
      },
      "ContextPackRequest": {
        "properties": {
          "as_of": {
            "description": "Business date of the event: rules apply as of this date",
            "format": "date",
            "title": "As Of",
            "type": "string"
          },
          "case": {
            "additionalProperties": true,
            "description": "The case, in the domain pack's format",
            "title": "Case",
            "type": "object"
          },
          "domain": {
            "description": "Domain pack name, e.g. custom_invoices",
            "title": "Domain",
            "type": "string"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional extra search text",
            "title": "Query"
          },
          "scope": {
            "description": "Scope node the work happens at (reads resolve upward)",
            "format": "uuid",
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "domain",
          "case",
          "scope",
          "purpose",
          "as_of"
        ],
        "title": "ContextPackRequest",
        "type": "object"
      },
      "CorrectionAccepted": {
        "properties": {
          "decision_record_id": {
            "format": "uuid",
            "title": "Decision Record Id",
            "type": "string"
          },
          "proposed_record_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposed Record Id"
          },
          "review_case_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Case Id"
          }
        },
        "required": [
          "decision_record_id",
          "proposed_record_id",
          "review_case_id"
        ],
        "title": "CorrectionAccepted",
        "type": "object"
      },
      "CorrectionRequest": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "correction": {
            "additionalProperties": true,
            "description": "Proposal vs final, in the domain pack's format",
            "title": "Correction",
            "type": "object"
          },
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "pack_id": {
            "format": "uuid",
            "title": "Pack Id",
            "type": "string"
          }
        },
        "required": [
          "pack_id",
          "domain",
          "case_id",
          "correction",
          "idempotency_key"
        ],
        "title": "CorrectionRequest",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.1.0",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HoldReason": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "reason": {
            "enum": [
              "rule_no_longer_approved",
              "new_mandatory_rule",
              "output_check_failed"
            ],
            "title": "Reason",
            "type": "string"
          },
          "record_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Record Id"
          }
        },
        "required": [
          "reason"
        ],
        "title": "HoldReason",
        "type": "object"
      },
      "PackRecord": {
        "properties": {
          "body": {
            "additionalProperties": true,
            "title": "Body",
            "type": "object"
          },
          "body_hash": {
            "title": "Body Hash",
            "type": "string"
          },
          "enforcement": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enforcement"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "overridden_by": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overridden By"
          },
          "record_id": {
            "format": "uuid",
            "title": "Record Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "constraint",
              "applied",
              "overridden",
              "candidate"
            ],
            "title": "Role",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "record_id",
          "version",
          "kind",
          "enforcement",
          "role",
          "body_hash",
          "body"
        ],
        "title": "PackRecord",
        "type": "object"
      },
      "RecordPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RecordSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Opaque; pass it back as `cursor` for the next page, null at the end",
            "title": "Next Cursor"
          },
          "policy_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Revision"
          }
        },
        "required": [
          "items",
          "next_cursor",
          "policy_revision"
        ],
        "title": "RecordPage",
        "type": "object"
      },
      "RecordRead": {
        "properties": {
          "authority": {
            "description": "Authority ladder rung (0–40), not a key",
            "maximum": 40.0,
            "minimum": 0.0,
            "title": "Authority",
            "type": "integer"
          },
          "enforcement": {
            "anyOf": [
              {
                "enum": [
                  "mandatory",
                  "prohibition",
                  "default"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enforcement"
          },
          "kind": {
            "enum": [
              "fact",
              "rule",
              "decision",
              "content"
            ],
            "title": "Kind",
            "type": "string"
          },
          "policy_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Revision"
          },
          "record_id": {
            "format": "uuid",
            "title": "Record Id",
            "type": "string"
          },
          "scope": {
            "format": "uuid",
            "title": "Scope",
            "type": "string"
          },
          "sensitivity_class": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ],
            "title": "Sensitivity Class",
            "type": "string"
          },
          "status": {
            "enum": [
              "proposed",
              "approved",
              "stale",
              "deprecated",
              "superseded",
              "erased"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Version of the record (1, 2, …), not a database key",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "record_id",
          "version",
          "kind",
          "status",
          "scope",
          "enforcement",
          "authority",
          "sensitivity_class",
          "policy_revision"
        ],
        "title": "RecordRead",
        "type": "object"
      },
      "RecordSummary": {
        "properties": {
          "authority": {
            "description": "Authority ladder rung (0–40), not a key",
            "maximum": 40.0,
            "minimum": 0.0,
            "title": "Authority",
            "type": "integer"
          },
          "enforcement": {
            "anyOf": [
              {
                "enum": [
                  "mandatory",
                  "prohibition",
                  "default"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enforcement"
          },
          "kind": {
            "enum": [
              "fact",
              "rule",
              "decision",
              "content"
            ],
            "title": "Kind",
            "type": "string"
          },
          "record_id": {
            "format": "uuid",
            "title": "Record Id",
            "type": "string"
          },
          "scope": {
            "format": "uuid",
            "title": "Scope",
            "type": "string"
          },
          "sensitivity_class": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ],
            "title": "Sensitivity Class",
            "type": "string"
          },
          "status": {
            "enum": [
              "proposed",
              "approved",
              "stale",
              "deprecated",
              "superseded",
              "erased"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Version of the record (1, 2, …), not a database key",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "record_id",
          "version",
          "kind",
          "status",
          "scope",
          "enforcement",
          "authority",
          "sensitivity_class"
        ],
        "title": "RecordSummary",
        "type": "object"
      },
      "VerifyRequest": {
        "properties": {
          "output": {
            "additionalProperties": true,
            "description": "What the agent is about to post",
            "title": "Output",
            "type": "object"
          },
          "pack_id": {
            "format": "uuid",
            "title": "Pack Id",
            "type": "string"
          }
        },
        "required": [
          "pack_id",
          "output"
        ],
        "title": "VerifyRequest",
        "type": "object"
      },
      "VerifyResult": {
        "properties": {
          "pack_id": {
            "format": "uuid",
            "title": "Pack Id",
            "type": "string"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/HoldReason"
            },
            "title": "Reasons",
            "type": "array"
          },
          "result": {
            "enum": [
              "pass",
              "hold"
            ],
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "pack_id",
          "result",
          "reasons"
        ],
        "title": "VerifyResult",
        "type": "object"
      },
      "WhoAmI": {
        "properties": {
          "consumer_id": {
            "title": "Consumer Id",
            "type": "string"
          },
          "end_user_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End User Id"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "consumer_id",
          "tenant_id",
          "end_user_id",
          "scopes"
        ],
        "title": "WhoAmI",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Governed organisational memory: the /v1/cortex consumer contract (PoC).",
    "title": "Cortex API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/cortex/context-packs": {
      "post": {
        "operationId": "request_context_pack",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContextPackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextPack"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Missing or unknown API key"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Insufficient scope, or denied by policy"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid request"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Implemented"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Access gate (policy engine) unavailable: fail closed"
          }
        },
        "summary": "Request Context Pack",
        "tags": [
          "cortex"
        ],
        "x-mcp-tool": {
          "description": "Get the governed context for one case: every applicable mandatory rule and prohibition, relevant approved knowledge, stored as a pack with an id to verify against.",
          "name": "request_context_pack"
        }
      }
    },
    "/v1/cortex/corrections": {
      "post": {
        "operationId": "submit_correction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorrectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorrectionAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Missing or unknown API key"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Insufficient scope, or denied by policy"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid request"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Implemented"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Access gate (policy engine) unavailable: fail closed"
          }
        },
        "summary": "Submit Correction",
        "tags": [
          "cortex"
        ],
        "x-mcp-tool": {
          "description": "Report a reviewer's correction of an output (with its pack id). Cortex records the decision and may propose a rule for a named owner to approve.",
          "name": "submit_correction"
        }
      }
    },
    "/v1/cortex/records": {
      "get": {
        "description": "Current versions visible at `scope` for `purpose`, ordered by record id\n(ULIDs: creation order). Only scopes OPA allows, never above the purpose's\nsensitivity ceiling; RLS keeps the tenant.",
        "operationId": "list_records",
        "parameters": [
          {
            "description": "Scope node to read at; resolves upward",
            "in": "query",
            "name": "scope",
            "required": true,
            "schema": {
              "description": "Scope node to read at; resolves upward",
              "format": "uuid",
              "title": "Scope",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "purpose",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "Purpose",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "default": "approved",
              "title": "Status",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Missing or unknown API key"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Insufficient scope, or denied by policy"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid request"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Access gate (policy engine) unavailable: fail closed"
          }
        },
        "summary": "List Records",
        "tags": [
          "cortex"
        ]
      }
    },
    "/v1/cortex/records/{record_id}": {
      "get": {
        "description": "One record's current version. Another tenant's record is a 404, exactly\nlike a missing one: no existence oracle across tenants.",
        "operationId": "get_record",
        "parameters": [
          {
            "in": "path",
            "name": "record_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Record Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "purpose",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "Purpose",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Missing or unknown API key"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Insufficient scope, or denied by policy"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid request"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Access gate (policy engine) unavailable: fail closed"
          }
        },
        "summary": "Get Record",
        "tags": [
          "cortex"
        ]
      }
    },
    "/v1/cortex/verify": {
      "post": {
        "operationId": "verify_output",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
